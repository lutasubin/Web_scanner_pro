<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/native_ad_small_layout"
        android:background="@color/ad_back"
        android:paddingTop="2dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">
            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_margin="5dp"
                android:adjustViewBounds="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ad_text"
                    android:ellipsize="end"
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:maxLines="1"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <TextView style="@style/AdAttribution"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ad_text"
                        android:ellipsize="end"
                        android:id="@+id/ad_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="20dp"
                        android:maxLines="2"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="20dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/ad_call_to_action"
            android:background="@drawable/ad_button_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:paddingTop="14dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0"/>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
